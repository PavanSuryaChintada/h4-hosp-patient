# Fixtures are compared byte-for-byte against a fresh generator run; keep LF on every OS.
tests/fixtures/** text eol=lf

# Windows batch files need CRLF to run reliably.
*.cmd text eol=crlf
# Shell scripts must keep LF to run on macOS and Linux.
*.sh text eol=lf

# The submission files are compared byte for byte with a fresh run.py; never convert their line endings.
submission/*.csv -text
